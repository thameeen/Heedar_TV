<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Existing tokens (referenced by the current layouts) -->
    <dimen name="screen_padding">32dp</dimen>
    <dimen name="field_height">52dp</dimen>
    <dimen name="item_spacing">8dp</dimen>
    <dimen name="logo_size">48dp</dimen>
    <dimen name="corner_radius">8dp</dimen>
    <dimen name="title_text_size">24sp</dimen>

    <!-- Spacing scale -->
    <dimen name="space_xs">4dp</dimen>
    <dimen name="space_sm">8dp</dimen>
    <dimen name="space_md">16dp</dimen>
    <dimen name="space_lg">24dp</dimen>
    <dimen name="space_xl">32dp</dimen>

    <!-- Navigation -->
    <dimen name="nav_rail_width">96dp</dimen>
    <dimen name="nav_bar_height">64dp</dimen>
    <dimen name="nav_icon_size">24dp</dimen>

    <!-- Content cards: poster ratio 2:3 -->
    <dimen name="card_width">128dp</dimen>
    <dimen name="card_height">192dp</dimen>
    <dimen name="card_width_tv">180dp</dimen>
    <dimen name="card_height_tv">270dp</dimen>
    <dimen name="card_corner">10dp</dimen>
    <dimen name="grid_spacing">12dp</dimen>

    <!-- Focus ring for D-pad navigation -->
    <dimen name="focus_stroke">2dp</dimen>
    <dimen name="chip_height">40dp</dimen>
    <dimen name="chip_spacing">8dp</dimen>

    <!-- Type scale -->
    <dimen name="text_display">28sp</dimen>
    <dimen name="text_section_header">18sp</dimen>
    <dimen name="text_card_title">13sp</dimen>
    <dimen name="text_body">14sp</dimen>
    <dimen name="text_caption">12sp</dimen>

    <dimen name="empty_icon_size">72dp</dimen>

    <!-- Grid spacing must exist in the default configuration: GridSpan reads it on
         phones too, and a sw600dp-only definition would crash at runtime there. -->
    <dimen name="card_grid_spacing">12dp</dimen>
</resources>
