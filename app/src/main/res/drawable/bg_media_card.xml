<?xml version="1.0" encoding="utf-8"?>
<!-- Card surface: flat when idle, gold-outlined when the remote focuses it. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_elevated" />
            <corners android:radius="@dimen/corner_radius" />
            <stroke
                android:width="@dimen/focus_stroke"
                android:color="@color/focus_ring" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_elevated" />
            <corners android:radius="@dimen/corner_radius" />
            <stroke
                android:width="@dimen/focus_stroke"
                android:color="@color/accent_dim" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <corners android:radius="@dimen/corner_radius" />
            <stroke
                android:width="1dp"
                android:color="@color/divider" />
        </shape>
    </item>

</selector>
