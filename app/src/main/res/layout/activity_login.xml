<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <!-- اسم التطبيق -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Heedar TV"
        android:textColor="#00FF66"
        android:textSize="36sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp"/>

    <!-- حقل رابط السيرفر -->
    <EditText
        android:id="@+id/etServerUrl"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="#1E1E1E"
        android:hint="رابط السيرفر (مثل: http://server:8080)"
        android:textColor="#FFFFFF"
        android:textColorHint="#9CA3AF"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:inputType="textUri"/>

    <!-- حقل اسم المستخدم -->
    <EditText
        android:id="@+id/etUsername"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="#1E1E1E"
        android:hint="اسم المستخدم (Username)"
        android:textColor="#FFFFFF"
        android:textColorHint="#9CA3AF"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="16dp"/>

    <!-- حقل كلمة المرور -->
    <EditText
        android:id="@+id/etPassword"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="#1E1E1E"
        android:hint="كلمة المرور (Password)"
        android:textColor="#FFFFFF"
        android:textColorHint="#9CA3AF"
        android:inputType="textPassword"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="24dp"/>

    <!-- زر تسجيل الدخول بالأخضر -->
    <Button
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:backgroundTint="#00FF66"
        android:text="تسجيل الدخول"
        android:textColor="#121212"
        android:textSize="18sp"
        android:textStyle="bold"/>

</LinearLayout>
